# Copie este arquivo para `.env` e preencha com os valores do painel do Supabase
# (Project Settings -> API Keys). NÃO coloque a secret key (sb_secret_...) aqui
# nem em nenhuma variável VITE_* — ela é só para backend/Edge Functions.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
